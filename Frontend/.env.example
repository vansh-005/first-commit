# Configuration for the Recollect frontend. Copy to .env.local and fill in values from YOUR deployment.
# Nothing here is a secret, but nothing is hardcoded in source either: each environment supplies its own.

# Base URL of the deployed API Gateway HTTP API (no trailing slash)
VITE_API_BASE_URL=

# Cognito OIDC settings (user pool issuer URL, app client ID, hosted-UI domain, custom API scope)
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_API_SCOPE=
